{
  "name": "@greenroom/server",
  "version": "0.0.0",
  "description": "Greenroom sidecar: review store, magic-link reviewer auth, build hosting",
  "license": "MIT",
  "type": "module",
  "bin": {
    "greenroom": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts serve",
