{
  "name": "@igility/greenroom-server",
  "version": "0.0.0",
  "description": "Greenroom sidecar: review store, magic-link reviewer auth, build hosting",
  "license": "MIT",
  "type": "module",
  "bin": {
    "greenroom": "./dist/cli.js"
  },
  "files": [
    "dist",
    "shell"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "prepack": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts serve",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@igility/greenroom-shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.2",
    "hono": "^4.13.1",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
