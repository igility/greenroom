{
  "name": "@greenroom/shared",
  "version": "0.0.0",
  "description": "Shared types, status policy, and fingerprint helpers for Greenroom",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
