{
  "name": "@igility/greenroom-addon",
  "version": "0.1.9",
  "description": "Greenroom Storybook addon: Review panel + pin-drop overlay",
  "license": "MIT",
  "homepage": "https://github.com/igility/greenroom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igility/greenroom.git",
    "directory": "packages/addon"
  },
  "keywords": [
    "storybook",
    "storybook-addon",
    "design-review",
    "code-review",
    "mcp"
  ],
  "main": "./preset.js",
  "files": [
    "dist",
    "preset.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm --filter @igility/greenroom-shared build && tsup",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "devDependencies": {
    "@igility/greenroom-shared": "workspace:*",
    "@medv/finder": "^4.0.2",
    "@storybook/icons": "^2.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "jsdom": "^30.0.1",
    "modern-screenshot": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
