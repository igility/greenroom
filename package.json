{
  "name": "greenroom-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Greenroom — per-story review and sign-off for Storybook, readable by AI agents over MCP",
  "license": "MIT",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:demo": "pnpm --filter demo-storybook storybook",
    "build:demo": "pnpm --filter demo-storybook build-storybook",
    "e2e": "playwright test",
    "verify:exit-bar": "node packages/mcp/verify/exit-bar.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
